{
  "name": "dogent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:home": "wxt build --mode home",
    "build:company": "wxt build --mode company",
    "zip": "wxt zip",
    "zip:company": "wxt zip --mode company",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mock:site": "node mock-site/server.mjs",
    "mock:llm": "node tools/mock-llm.mjs",
    "postinstall": "wxt prepare",
    "e2e": "node tests/e2e/extension.e2e.mjs",
    "e2e:ollama": "node tests/e2e/extension.e2e.mjs --ollama",
    "ollama:proxy": "node tools/ollama-proxy.mjs",
    "skill:new": "node tools/skill-new.mjs",
    "skill:index": "node tools/skill-index.mjs",
    "skill:lint": "vitest run tests/author.test.ts -t 번들된"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wxt": "^0.21.4"
  }
}
