# 배포용 빌드에 넣을 모델 접속 정보.
# 이 파일을 .env.local 로 복사해 값을 채운 뒤 pnpm build 를 실행한다.
# .env.local 은 Git에 올라가지 않는다. API 키를 저장소나 dogent.config.ts 에 적지 않는다.

# 사내 Gemma API 주소 (OpenAI 호환, /v1 까지). 이 호스트는 확장의 접근 허용 목록에 자동으로 들어간다.
WXT_LLM_BASE_URL=https://gemma.example.internal/v1

# 공용 API 키. 사용자의 설정 화면에는 보이지 않지만, 빌드된 확장 파일 안에는 그대로 들어간다.
WXT_LLM_API_KEY=

# 모델 이름
WXT_LLM_MODEL=gemma

# (선택) 공유 스킬 저장소의 목록 파일 주소. 적으면 확장을 다시 배포하지 않고 스킬을 더하거나 고칠 수 있다.
# 저장소는 skills 폴더를 사내 파일 서버나 Git에 그대로 올린 것이고, 목록은 pnpm skill:index 가 만든다.
# WXT_SKILLS_URL=https://files.example.internal/dogent-skills/index.json
