# 회사 PC: 사내 Gemma API(게이트웨이)로 쓸 때의 빌드 설정.
#   1) 이 파일을 .env.company.local 로 복사하고 (Git에 올라가지 않는다) 아래 (…) 를 채운다
#   2) pnpm build:company  →  .output/chrome-mv3-company 를 chrome://extensions 에서 로드
#   3) 사이드 패널 → 설정 → 사용자 ID 입력 → 연결 시험
# 빌드할 때 터미널에 "빌드 설정: company" 요약이 찍힌다. 주소·모델·헤더 이름이 맞는지 보고 로드한다.
# 이 파일과 빌드 결과물에는 키가 그대로 들어간다. 저장소·메일·메신저로 옮기지 않는다.

# API 제공 측에서 받은 api_base_url. /chat/completions 앞까지만 적는다 (보통 …/v1)
WXT_LLM_BASE_URL=(api_base_url)
# API 제공 측에서 받은 credential_key. 아래 헤더 틀의 {key} 자리에 들어간다
WXT_LLM_API_KEY=(credential_key)
# API 제공 측에서 받은 model
WXT_LLM_MODEL=(model)

# 요청 헤더 틀 (JSON 한 줄, 작은따옴표로 감싼다). 주면 Authorization: Bearer 대신 이 헤더들을 보낸다.
# 값의 자리표시자는 요청할 때 채워진다:
#   {key}        위의 WXT_LLM_API_KEY
#   {userId}     사용자 ID. 사람마다 다르므로 패널 → 설정에서 각자 입력한다 (아래 WXT_LLM_USER_ID로 미리 넣어도 된다)
#   {userType}   사용자 유형. API 제공 측이 안내한 값을 WXT_LLM_USER_TYPE에 적는다
#   {systemName} 시스템 이름. 아래 WXT_LLM_SYSTEM_NAME (기본 RFGo)
#   {uuid}       요청마다 새로 만드는 UUID (메시지 ID용)
# Send-System-Name은 틀에 없어도 시스템 이름으로 늘 붙는다. 틀에 값을 글자로 적으면 그 값이 우선한다.
WXT_LLM_HEADERS='{"x-dep-ticket":"{key}","Send-System-Name":"{systemName}","user-id":"{userId}","user-type":"{userType}","prompt-msg-id":"{uuid}","completion-msg-id":"{uuid}","accept":"application/json","content-type":"application/json"}'
WXT_LLM_USER_TYPE=(user_type)
# 사내 게이트웨이에 등록한 시스템 이름 (Send-System-Name 헤더). 비워 두면 RFGo
WXT_LLM_SYSTEM_NAME=RFGo
# 혼자 쓰는 빌드라면 자기 ID를 미리 넣어 둘 수 있다. 나눠 줄 빌드에는 비워 둔다.
WXT_LLM_USER_ID=

# 사내 API가 response_format: json_object 를 지원하면 true
WXT_LLM_JSON_MODE=false
# 응답이 느리면 2~3
WXT_LLM_TIMEOUT_SCALE=1

# 에이전트가 조작할 사내 시스템 주소 (쉼표로 여러 개). 업무 화면이 iframe으로 다른 호스트를 열면 그것도 넣는다.
# 화면 점검에서 "읽지 못한 iframe"이 나오면 거기 적힌 주소를 여기 더한다.
WXT_SITE_PERMISSIONS=https://(업무 시스템 호스트)/*

# (선택) 공유 스킬 저장소
# WXT_SKILLS_URL=https://(파일 서버)/dogent-skills/index.json
