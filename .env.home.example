# 집 PC: 로컬 Ollama로 개발할 때 쓰는 빌드 설정.
#   1) 이 파일을 .env.home.local 로 복사한다 (Git에 올라가지 않는다)
#   2) pnpm build:home  →  .output/chrome-mv3-home 을 chrome://extensions 에서 로드
#   3) 터미널에서 pnpm mock:site, pnpm ollama:proxy 를 띄운다
# 확장은 Ollama(11434)를 직접 부르지 않고 중계 서버(4174)를 거친다 (README "로컬 Ollama로 돌려 보기").

WXT_LLM_BASE_URL=http://localhost:4174/v1
# ollama list 에 보이는 이름
WXT_LLM_MODEL=gemma3:12b
# Ollama의 JSON 강제 출력을 쓴다 (형식 오류가 줄어든다)
WXT_LLM_JSON_MODE=true
# GPU 없이 CPU로 돌면 3 이상
WXT_LLM_TIMEOUT_SCALE=3
